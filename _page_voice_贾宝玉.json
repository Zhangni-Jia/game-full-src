[
  {
    "who": "贾宝玉",
    "text": "妹妹这般沉静模样实在难得。",
    "filename": "vp_by_0019"
  },
  {
    "who": "贾宝玉",
    "text": "只是想起从前，你常为落花伤情，为片言辗转难安，如今这般淡然，我反倒有些恍惚。",
    "filename": "vp_by_0020"
  },
  {
    "who": "贾宝玉",
    "text": "妹妹切莫误会！",
    "filename": "vp_by_0021"
  },
  {
    "who": "贾宝玉",
    "text": "昔日你落泪，我心中疼惜却无从宽慰。",
    "filename": "vp_by_0022"
  },
  {
    "who": "贾宝玉",
    "text": "如今你神色安然，我才觉，这该是你的本貌。",
    "filename": "vp_by_0023"
  },
  {
    "who": "贾宝玉",
    "text": "无论何种模样，于我皆是一样。",
    "filename": "vp_by_0024"
  },
  {
    "who": "贾宝玉",
    "text": "听清了！",
    "filename": "vp_by_0025"
  },
  {
    "who": "贾宝玉",
    "text": "多谢妹妹夸赞！",
    "filename": "vp_by_0026"
  },
  {
    "who": "贾宝玉",
    "text": "妹妹小小年纪，竟有这般通透心性。",
    "filename": "vp_by_0029"
  },
  {
    "who": "贾宝玉",
    "text": "可我想问，勘破执念之后，妹妹心中，可还存着执念？",
    "filename": "vp_by_0030"
  },
  {
    "who": "贾宝玉",
    "text": "覆辙？",
    "filename": "vp_by_0033"
  },
  {
    "who": "贾宝玉",
    "text": "妹妹昔日受过何等苦楚，听得我心口发闷。",
    "filename": "vp_by_0034"
  },
  {
    "who": "贾宝玉",
    "text": "妹妹这番话，我牢牢记住。",
    "filename": "vp_by_0037"
  },
  {
    "who": "贾宝玉",
    "text": "往后我若再犯痴愚，还望妹妹点醒我。",
    "filename": "vp_by_0038"
  },
  {
    "who": "贾宝玉",
    "text": "我？",
    "filename": "vp_by_0041"
  },
  {
    "who": "贾宝玉",
    "text": "我怎配点醒妹妹？",
    "filename": "vp_by_0042"
  },
  {
    "who": "贾宝玉",
    "text": "好！",
    "filename": "vp_by_0043"
  },
  {
    "who": "贾宝玉",
    "text": "但凡你深陷烦忧，我必竭力将你拉出！",
    "filename": "vp_by_0044"
  },
  {
    "who": "贾宝玉",
    "text": "便是骂我呆子，我也欢喜。",
    "filename": "vp_by_0045"
  },
  {
    "who": "贾宝玉",
    "text": "妹妹愿意寄望于我，已是难得。",
    "filename": "vp_by_0046"
  },
  {
    "who": "贾宝玉",
    "text": "妹妹切莫这般说。",
    "filename": "vp_by_0047"
  },
  {
    "who": "贾宝玉",
    "text": "若是疲乏，我便缄默陪在一旁，你何时想说话，再唤我便是。",
    "filename": "vp_by_0048"
  },
  {
    "who": "贾宝玉",
    "text": "满园花开灼灼，终究要随⻛飘零。",
    "filename": "vp_by_0115"
  },
  {
    "who": "贾宝玉",
    "text": "这般美好留不住，实在令人怅惘。",
    "filename": "vp_by_0116"
  },
  {
    "who": "贾宝玉",
    "text": "眼前人？",
    "filename": "vp_by_0119"
  },
  {
    "who": "贾宝玉",
    "text": "妹妹指的是……",
    "filename": "vp_by_0120"
  },
  {
    "who": "贾宝玉",
    "text": "那不一样。",
    "filename": "vp_by_0123"
  },
  {
    "who": "贾宝玉",
    "text": "妹妹心里有数，才算。",
    "filename": "vp_by_0124"
  },
  {
    "who": "贾宝玉",
    "text": "我……",
    "filename": "vp_by_0127"
  },
  {
    "who": "贾宝玉",
    "text": "我不知。",
    "filename": "vp_by_0128"
  },
  {
    "who": "贾宝玉",
    "text": "妹妹又当如何？",
    "filename": "vp_by_0129"
  },
  {
    "who": "贾宝玉",
    "text": "妹妹教我，我定然用心学。",
    "filename": "vp_by_0135"
  },
  {
    "who": "贾宝玉",
    "text": "那是自然！",
    "filename": "vp_by_0136"
  },
  {
    "who": "贾宝玉",
    "text": "就算我身陷险境，也必护妹妹周全。",
    "filename": "vp_by_0137"
  },
  {
    "who": "贾宝玉",
    "text": "一同离开。",
    "filename": "vp_by_0139"
  },
  {
    "who": "贾宝玉",
    "text": "记下了。",
    "filename": "vp_by_0140"
  },
  {
    "who": "贾宝玉",
    "text": "妹妹快看，梨花漫天纷⻜，纵然开得再盛，终究难逃凋零。",
    "filename": "vp_by_0185"
  },
  {
    "who": "贾宝玉",
    "text": "方才我一直在寻你。",
    "filename": "vp_by_0186"
  },
  {
    "who": "贾宝玉",
    "text": "那妹妹愿意⻅我吗？",
    "filename": "vp_by_0192"
  },
  {
    "who": "贾宝玉",
    "text": "自然准许！",
    "filename": "vp_by_0195"
  },
  {
    "who": "贾宝玉",
    "text": "妹妹何时来，我何时都在。",
    "filename": "vp_by_0196"
  },
  {
    "who": "贾宝玉",
    "text": "妹妹此言……",
    "filename": "vp_by_0199"
  },
  {
    "who": "贾宝玉",
    "text": "莫非这园子，乃至整个贾府，已经潜藏大祸？",
    "filename": "vp_by_0200"
  },
  {
    "who": "贾宝玉",
    "text": "我先来问妹妹主意。",
    "filename": "vp_by_0203"
  },
  {
    "who": "贾宝玉",
    "text": "还未曾。",
    "filename": "vp_by_0206"
  },
  {
    "who": "贾宝玉",
    "text": "府中上下都在鼓吹金玉良缘，人人都在逼迫我顺从世俗。",
    "filename": "vp_by_0248"
  },
  {
    "who": "贾宝玉",
    "text": "满府人心动荡，唯有你待我一如往昔。",
    "filename": "vp_by_0249"
  },
  {
    "who": "贾宝玉",
    "text": "我心中，自始至终只有你一人。",
    "filename": "vp_by_0250"
  },
  {
    "who": "贾宝玉",
    "text": "妹妹……",
    "filename": "vp_by_0255"
  },
  {
    "who": "贾宝玉",
    "text": "是觉得我太过累赘，心生倦怠了吗？",
    "filename": "vp_by_0256"
  },
  {
    "who": "贾宝玉",
    "text": "好，我答应妹妹。",
    "filename": "vp_by_0262"
  },
  {
    "who": "贾宝玉",
    "text": "无论如何，我都会撑住。",
    "filename": "vp_by_0263"
  },
  {
    "who": "贾宝玉",
    "text": "我刻在心间。",
    "filename": "vp_by_0274"
  },
  {
    "who": "贾宝玉",
    "text": "往后⻛雨，我愿与你并肩。",
    "filename": "vp_by_0275"
  },
  {
    "who": "贾宝玉",
    "text": "妹妹，我过得太煎熬。",
    "filename": "vp_by_0320"
  },
  {
    "who": "贾宝玉",
    "text": "府中⻓辈轮番规劝金玉良缘，世俗规矩层层压身，我心中不愿，可孤身一人，无力对抗满府的舆论。",
    "filename": "vp_by_0321"
  },
  {
    "who": "贾宝玉",
    "text": "唯有妹妹懂我！",
    "filename": "vp_by_0324"
  },
  {
    "who": "贾宝玉",
    "text": "旁人皆说我顽劣叛逆，只有你明白我的本心。",
    "filename": "vp_by_0325"
  },
  {
    "who": "贾宝玉",
    "text": "我快要撑不住了。",
    "filename": "vp_by_0326"
  },
  {
    "who": "贾宝玉",
    "text": "有妹妹这句话，我便能咬牙坚持。",
    "filename": "vp_by_0330"
  },
  {
    "who": "贾宝玉",
    "text": "我只求守住本心，守在妹妹身侧，仅此而已。",
    "filename": "vp_by_0331"
  },
  {
    "who": "贾宝玉",
    "text": "那我该如何改变？",
    "filename": "vp_by_0338"
  },
  {
    "who": "贾宝玉",
    "text": "我不愿永远任人摆布。",
    "filename": "vp_by_0339"
  },
  {
    "who": "贾宝玉",
    "text": "我听妹妹所言！",
    "filename": "vp_by_0343"
  },
  {
    "who": "贾宝玉",
    "text": "往后不再沉溺⻛月愁思，我要变强，护你周全。",
    "filename": "vp_by_0344"
  },
  {
    "who": "贾宝玉",
    "text": "连妹妹也要劝我妥协？",
    "filename": "vp_by_0347"
  },
  {
    "who": "贾宝玉",
    "text": "我坚守的情意，果真一文不值吗？",
    "filename": "vp_by_0348"
  },
  {
    "who": "贾宝玉",
    "text": "我想明白了。",
    "filename": "vp_by_0392"
  },
  {
    "who": "贾宝玉",
    "text": "我不愿再做老太太眼中的宝玉，不愿做贾府的宝玉。",
    "filename": "vp_by_0393"
  },
  {
    "who": "贾宝玉",
    "text": "我只想做，你眼中的宝玉。",
    "filename": "vp_by_0394"
  },
  {
    "who": "贾宝玉",
    "text": "我猜……",
    "filename": "vp_by_0401"
  },
  {
    "who": "贾宝玉",
    "text": "妹妹愿意等，但不会空等。",
    "filename": "vp_by_0402"
  },
  {
    "who": "贾宝玉",
    "text": "⻛雨终落定，世俗皆让步。",
    "filename": "vp_by_0449"
  },
  {
    "who": "贾宝玉",
    "text": "这一世，我挣脱了家族桎梏，守住本心，也守住了你。",
    "filename": "vp_by_0450"
  },
  {
    "who": "贾宝玉",
    "text": "皆是你教会我的。",
    "filename": "vp_by_0451"
  },
  {
    "who": "贾宝玉",
    "text": "从前我为落花悲戚、为世事迷茫，如今我懂，万般⻛月，不及一人相守。",
    "filename": "vp_by_0452"
  },
  {
    "who": "贾宝玉",
    "text": "往后山河安稳，我伴你赏花煮茶、岁岁年年。",
    "filename": "vp_by_0453"
  },
  {
    "who": "贾宝玉",
    "text": "不恋浮华，不随世俗，只守你一人。",
    "filename": "vp_by_0454"
  }
]