{
  "who": "贾宝玉",
  "items": [
    {
      "who": "贾宝玉",
      "text": "妹妹这般沉静模样实在难得。",
      "filename": "vp_by_0019"
    },
    {
      "who": "贾宝玉",
      "text": "只是想起从前，你常为落花伤情，为片言辗转难安，如今这般淡然，我反倒有些恍惚。",
      "filename": "vp_by_0020"
    },
    {
      "who": "贾宝玉",
      "text": "妹妹切莫误会！",
      "filename": "vp_by_0021"
    },
    {
      "who": "贾宝玉",
      "text": "昔日你落泪，我心中疼惜却无从宽慰。",
      "filename": "vp_by_0022"
    },
    {
      "who": "贾宝玉",
      "text": "如今你神色安然，我才觉，这该是你的本貌。",
      "filename": "vp_by_0023"
    },
    {
      "who": "贾宝玉",
      "text": "无论何种模样，于我皆是一样。",
      "filename": "vp_by_0024"
    },
    {
      "who": "贾宝玉",
      "text": "听清了！",
      "filename": "vp_by_0025"
    },
    {
      "who": "贾宝玉",
      "text": "多谢妹妹夸赞！",
      "filename": "vp_by_0026"
    },
    {
      "who": "贾宝玉",
      "text": "妹妹小小年纪，竟有这般通透心性。",
      "filename": "vp_by_0029"
    },
    {
      "who": "贾宝玉",
      "text": "可我想问，勘破执念之后，妹妹心中，可还存着执念？",
      "filename": "vp_by_0030"
    },
    {
      "who": "贾宝玉",
      "text": "覆辙？",
      "filename": "vp_by_0033"
    },
    {
      "who": "贾宝玉",
      "text": "妹妹昔日受过何等苦楚，听得我心口发闷。",
      "filename": "vp_by_0034"
    },
    {
      "who": "贾宝玉",
      "text": "妹妹这番话，我牢牢记住。",
      "filename": "vp_by_0037"
    },
    {
      "who": "贾宝玉",
      "text": "往后我若再犯痴愚，还望妹妹点醒我。",
      "filename": "vp_by_0038"
    },
    {
      "who": "贾宝玉",
      "text": "我？",
      "filename": "vp_by_0041"
    },
    {
      "who": "贾宝玉",
      "text": "我怎配点醒妹妹？",
      "filename": "vp_by_0042"
    },
    {
      "who": "贾宝玉",
      "text": "好！",
      "filename": "vp_by_0043"
    },
    {
      "who": "贾宝玉",
      "text": "但凡你深陷烦忧，我必竭力将你拉出！",
      "filename": "vp_by_0044"
    },
    {
      "who": "贾宝玉",
      "text": "便是骂我呆子，我也欢喜。",
      "filename": "vp_by_0045"
    },
    {
      "who": "贾宝玉",
      "text": "妹妹愿意寄望于我，已是难得。",
      "filename": "vp_by_0046"
    },
    {
      "who": "贾宝玉",
      "text": "妹妹切莫这般说。",
      "filename": "vp_by_0047"
    },
    {
      "who": "贾宝玉",
      "text": "若是疲乏，我便缄默陪在一旁，你何时想说话，再唤我便是。",
      "filename": "vp_by_0048"
    },
    {
      "who": "贾宝玉",
      "text": "满园花开灼灼，终究要随⻛飘零。",
      "filename": "vp_by_0115"
    },
    {
      "who": "贾宝玉",
      "text": "这般美好留不住，实在令人怅惘。",
      "filename": "vp_by_0116"
    },
    {
      "who": "贾宝玉",
      "text": "眼前人？",
      "filename": "vp_by_0119"
    },
    {
      "who": "贾宝玉",
      "text": "妹妹指的是……",
      "filename": "vp_by_0120"
    },
    {
      "who": "贾宝玉",
      "text": "那不一样。",
      "filename": "vp_by_0123"
    },
    {
      "who": "贾宝玉",
      "text": "妹妹心里有数，才算。",
      "filename": "vp_by_0124"
    },
    {
      "who": "贾宝玉",
      "text": "我……",
      "filename": "vp_by_0127"
    },
    {
      "who": "贾宝玉",
      "text": "我不知。",
      "filename": "vp_by_0128"
    },
    {
      "who": "贾宝玉",
      "text": "妹妹又当如何？",
      "filename": "vp_by_0129"
    },
    {
      "who": "贾宝玉",
      "text": "妹妹教我，我定然用心学。",
      "filename": "vp_by_0135"
    },
    {
      "who": "贾宝玉",
      "text": "那是自然！",
      "filename": "vp_by_0136"
    },
    {
      "who": "贾宝玉",
      "text": "就算我身陷险境，也必护妹妹周全。",
      "filename": "vp_by_0137"
    },
    {
      "who": "贾宝玉",
      "text": "一同离开。",
      "filename": "vp_by_0139"
    },
    {
      "who": "贾宝玉",
      "text": "记下了。",
      "filename": "vp_by_0140"
    },
    {
      "who": "贾宝玉",
      "text": "妹妹快看，梨花漫天纷⻜，纵然开得再盛，终究难逃凋零。",
      "filename": "vp_by_0185"
    },
    {
      "who": "贾宝玉",
      "text": "方才我一直在寻你。",
      "filename": "vp_by_0186"
    },
    {
      "who": "贾宝玉",
      "text": "那妹妹愿意⻅我吗？",
      "filename": "vp_by_0192"
    },
    {
      "who": "贾宝玉",
      "text": "自然准许！",
      "filename": "vp_by_0195"
    }
  ]
}