[
  {
    "who": "北静王",
    "text": "小小年纪，便有守心定力。",
    "filename": "vp_bj_0053"
  },
  {
    "who": "北静王",
    "text": "只是贾府这潭浑水，远比姑娘所想更深，莫非姑娘已然窥⻅一二？",
    "filename": "vp_bj_0054"
  },
  {
    "who": "北静王",
    "text": "好一句与我无干。",
    "filename": "vp_bj_0057"
  },
  {
    "who": "北静王",
    "text": "府内人人争相算计，唯独你一个姑娘，能说出这般话，着实特别。",
    "filename": "vp_bj_0058"
  },
  {
    "who": "北静王",
    "text": "这杯茶，本王饮下。",
    "filename": "vp_bj_0063"
  },
  {
    "who": "北静王",
    "text": "林姑娘，本王记下你了。",
    "filename": "vp_bj_0064"
  },
  {
    "who": "北静王",
    "text": "姑娘行事懂事进退有度。",
    "filename": "vp_bj_0065"
  },
  {
    "who": "北静王",
    "text": "只是“一切尚好”四字，从你口中道出，听来更似客套。",
    "filename": "vp_bj_0066"
  },
  {
    "who": "北静王",
    "text": "体面人人会说，难得是说尽客套，眼底尚留几分本真。",
    "filename": "vp_bj_0069"
  },
  {
    "who": "北静王",
    "text": "姑娘不必对本王如此拘谨。",
    "filename": "vp_bj_0070"
  },
  {
    "who": "北静王",
    "text": "姑娘年纪轻轻，便懂藏锋敛锐。",
    "filename": "vp_bj_0074"
  },
  {
    "who": "北静王",
    "text": "可既知盛衰轮回，可知盛时该当何为？",
    "filename": "vp_bj_0075"
  },
  {
    "who": "北静王",
    "text": "说得极好。",
    "filename": "vp_bj_0078"
  },
  {
    "who": "北静王",
    "text": "可世间之人，盛时尚能修心，衰时懂得自保的，寥寥无几。",
    "filename": "vp_bj_0079"
  },
  {
    "who": "北静王",
    "text": "姑娘，你远比本王料想的清醒。",
    "filename": "vp_bj_0080"
  },
  {
    "who": "北静王",
    "text": "朝堂之上，日日⻅人来人往，我早已麻木。",
    "filename": "vp_bj_0159"
  },
  {
    "who": "北静王",
    "text": "你这一句话，倒叫我忆起故人。",
    "filename": "vp_bj_0160"
  },
  {
    "who": "北静王",
    "text": "本王记下。",
    "filename": "vp_bj_0163"
  },
  {
    "who": "北静王",
    "text": "方才⻅你立于梨花树下，似有心事萦怀。",
    "filename": "vp_bj_0207"
  },
  {
    "who": "北静王",
    "text": "懂得藏锋，是乱世自保的良方。",
    "filename": "vp_bj_0216"
  },
  {
    "who": "北静王",
    "text": "只是一味收敛锋芒，旁人便会以为你全无棱⻆。",
    "filename": "vp_bj_0217"
  },
  {
    "who": "北静王",
    "text": "当得。",
    "filename": "vp_bj_0220"
  },
  {
    "who": "北静王",
    "text": "本王静待。",
    "filename": "vp_bj_0221"
  },
  {
    "who": "北静王",
    "text": "朝堂局势已然明朗，贾府积重难返，倾覆已成定局。",
    "filename": "vp_bj_0276"
  },
  {
    "who": "北静王",
    "text": "这乱世滚滚红尘之中，我一心想要护下的人，唯有你。",
    "filename": "vp_bj_0277"
  },
  {
    "who": "北静王",
    "text": "姑娘不必思虑分毫，万事有我。",
    "filename": "vp_bj_0289"
  },
  {
    "who": "北静王",
    "text": "⻛波将至，我自会扫清所有阻碍。",
    "filename": "vp_bj_0290"
  },
  {
    "who": "北静王",
    "text": "朝堂⻛声骤然趋紧，贾府贪腐积弊已经查实，清算就在眼前。",
    "filename": "vp_bj_0353"
  },
  {
    "who": "北静王",
    "text": "我连夜梳理多方局势，只为将你从纠葛之中剥离，保你平安无恙。",
    "filename": "vp_bj_0354"
  },
  {
    "who": "北静王",
    "text": "于我而言，万千局势，不及你平安二字。",
    "filename": "vp_bj_0357"
  },
  {
    "who": "北静王",
    "text": "今夜不谈权谋，不谈利弊，只静坐赏月。",
    "filename": "vp_bj_0358"
  },
  {
    "who": "北静王",
    "text": "短则一年，⻓则三五年。",
    "filename": "vp_bj_0403"
  },
  {
    "who": "北静王",
    "text": "朝堂⻛云变幻，归期难料。",
    "filename": "vp_bj_0404"
  },
  {
    "who": "北静王",
    "text": "我想听⻅一句话。",
    "filename": "vp_bj_0405"
  },
  {
    "who": "北静王",
    "text": "若是我归来之时，姑娘尚在吗？",
    "filename": "vp_bj_0406"
  },
  {
    "who": "北静王",
    "text": "朝堂⻛波平息，世家棋局落幕。",
    "filename": "vp_bj_0455"
  },
  {
    "who": "北静王",
    "text": "我洗尽朝堂浮沉，换得一世安稳，只为与你并肩余生。",
    "filename": "vp_bj_0456"
  },
  {
    "who": "北静王",
    "text": "我懂你的⻛⻣。",
    "filename": "vp_bj_0457"
  },
  {
    "who": "北静王",
    "text": "我不再是高高在上的王爷，你亦不是寄人篱下的闺阁女子。",
    "filename": "vp_bj_0458"
  }
]